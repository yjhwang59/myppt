# LLM script generation (optional — falls back to template drafts)
OPENAI_API_KEY=
NARRATION_LLM_MODEL=gpt-4o-mini
# PDF decks: admin can send page PNG to vision models (gpt-4o-mini / gpt-4o / gpt-4.1*)
NARRATION_LLM_TIMEOUT_MS=60000
NARRATION_LLM_MAX_RETRIES=2

# TTS synthesis (optional — use --dry-run to skip)
NARRATION_TTS_PROVIDER=openai
NARRATION_TTS_VOICE=nova
NARRATION_TTS_SPEED=1.0
NARRATION_TTS_TIMEOUT_MS=120000
NARRATION_TTS_MAX_RETRIES=2
NARRATION_TTS_BUDGET_USD=5.00

# ElevenLabs instant voice clone.
# Decks opt in via manifest voice.provider=elevenlabs (see scripts/narration/clone-voice.js).
# If recordings/ is empty, the script keeps the account's existing cloned voice.
# multilingual_v2 is required for Chinese. Speed in the manifest is clamped to 0.7–1.2.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.75

# Admin server (local UI). ADMIN_SECRET signs the HttpOnly session cookie; it is not a password.
ADMIN_PORT=8787
ADMIN_SECRET=dev-admin-secret-change-me

# Google sign-in. The OAuth client must allow JavaScript origin https://aidc.work
# (the login window). Studio origins are http://localhost:8787 and https://myppt.aidc.work.
GOOGLE_CLIENT_ID=
# Comma-separated Google emails allowed to sign in
GOOGLE_ALLOWED_EMAILS=

# One-click publish (wrangler deploy from admin UI)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional: shown/copied after deploy if wrangler stdout parse fails
PUBLIC_DECK_BASE_URL=https://myppt.aidc.work

# Online studio reads OPENAI_API_KEY from a Worker secret (do not commit the value):
# npx wrangler secret put OPENAI_API_KEY
